# Copy to .env and edit. docker compose reads this file automatically.

# --- images ---------------------------------------------------------------
# Full image (Wine + WeChat + gateway), linux/amd64 only.
# Example: WXCAT_FULL_IMAGE=ghcr.io/kyresn/wxcat-wcf:latest
WXCAT_FULL_IMAGE=
# Gateway-only image, linux/amd64 + linux/arm64.
# Example: WXCAT_IMAGE=ghcr.io/kyresn/wxcat:latest
WXCAT_IMAGE=
# Version label baked into the binary; CI sets it from the git tag.
WXCAT_VERSION=dev

# --- runtime --------------------------------------------------------------
# VNC password for the noVNC desktop (http://host:6080/vnc.html)
VNC_PASSWORD=wxcat

# Backend: wcf | mimicwx | webhook
WXCAT_BACKEND=wcf

# WeChatFerry RPC addresses. For a remote backend use the socat bridges
# exposed by the full image on ports 11086/11087.
WXCAT_WCF_CMD_ADDR=tcp://127.0.0.1:11086
WXCAT_WCF_MSG_ADDR=tcp://127.0.0.1:11087
# Media agent on the WeChat host. Required for remote gateways so images and
# files can be decrypted/uploaded where WeChat runs.
WXCAT_WCF_MEDIA_URL=
WXCAT_WCF_MEDIA_TOKEN=

# WeFlow backend (optional, no injection)
WXCAT_WEFLOW_BASE_URL=http://127.0.0.1:5031
WXCAT_WEFLOW_TOKEN=
WXCAT_WEFLOW_SELF_WXID=
WXCAT_WEFLOW_SEND_MODE=uia
WXCAT_WEFLOW_SENDER_URL=
WXCAT_WEFLOW_SENDER_TOKEN=

# MimicWX backend (optional)
WXCAT_MIMICWX_BASE_URL=
WXCAT_MIMICWX_TOKEN=
WXCAT_MIMICWX_SELF_WXID=

# Convenience token applied to every OneBot endpoint that has no explicit token.
# Leave empty to use the tokens in config/wxcat.json.
WXCAT_TOKEN=

# Admin panel token (http://host:6099)
WXCAT_WEBUI_TOKEN=

# numeric (stable int64 ids) or raw (wxid strings)
WXCAT_ID_MODE=numeric

# Public prefix for /media URLs, e.g. http://192.168.1.10:3000
WXCAT_MEDIA_BASE_URL=

TZ=Asia/Shanghai
